# Copiez ce fichier en `.env` (ignoré par git) à côté de docker-compose.yml : Compose y lit les variables ci-dessous.
# En lancement local, `python -m studio` charge aussi ce `.env` au démarrage (une variable déjà exportée garde la priorité).
# Les trois réglages LLM peuvent aussi être saisis dans l'interface (⚙︎ Moteur → Assistant LLM) ; une variable
# définie ici a priorité et verrouille le champ correspondant.

# ---- Assistant de composition : service LLM OpenAI-compatible (OpenRouter, OpenAI, Mistral, Ollama, LM Studio, vLLM…).
# Optionnel : sans ces réglages, le studio fonctionne, seul l'assistant est désactivé.

# Clé API. Inutile pour un LLM local (Ollama, LM Studio).
YUE2_LLM_API_KEY=

# URL de base de l'API, jusqu'au /v1 (le studio appelle /chat/completions et /models). Exemples :
#   https://openrouter.ai/api/v1   https://api.openai.com/v1   https://api.mistral.ai/v1
#   http://localhost:11434/v1 (Ollama en lancement local)
#   http://host.docker.internal:11434/v1 (Ollama sur l'hôte, studio dans le conteneur)
YUE2_LLM_BASE_URL=https://openrouter.ai/api/v1

# Identifiant du modèle chez ce fournisseur. Exemples : anthropic/claude-sonnet-4.5 · gpt-5 · mistral-large-latest · qwen3:32b
YUE2_LLM_MODEL=

# ---- Studio

# Port publié sur l'hôte (défaut 8420).
YUE2_STUDIO_PORT=8420

# Jeton Hugging Face : inutile pour les modèles publics m-a-p/YuE2-*, seulement si votre réseau ou un miroir l'exige.
HF_TOKEN=
